<Window x:Class="BankingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BankingSystem.ViewModel"
        xmlns:conv="clr-namespace:BankingSystem.Converters"
        Title="Banking System" Height="600" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:CountryToFlagConverter x:Key="CountryToFlag"/>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0"/>
            <GradientStop Color="#1D4ED8" Offset="0.5"/>
            <GradientStop Color="#38BDF8" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="16">
        <Border Background="#CCFFFFFF" CornerRadius="16" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Add Account" Command="{Binding AddCommand}"
                            Width="120" Margin="0,0,10,0"/>
                    <Button Content="Account Details" Command="{Binding DetailsCommand}"
                            Width="130" Margin="0,0,10,0"/>
                    <Button Content="Delete Account" Command="{Binding DeleteCommand}"
                            Width="130"/>
                    <Button Content="Add Customer" Command="{Binding AddCustomerCommand}"
                            Width="140" Margin="10,0,10,0"/>
                    
                    <Button Content="Update Account"  Command="{Binding UpdateAccountCommand}"  Width="150"/>
                    <Button Content="Update Customer" Margin="10,0,10,0" Command="{Binding UpdateCustomerCommand}" Width="150"/>
                    <Button Content="Delete Customer" Command="{Binding DeleteCustomerCommand}" Width="145"
        Background="#DC2626"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Customers" Margin="0,0,10,0">
                        <DataGrid ItemsSource="{Binding Customers}"
                                  SelectedItem="{Binding SelectedCustomer}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Accounts" Grid.Column="1">
                        <DataGrid ItemsSource="{Binding FilteredAccounts}"
                                  SelectedItem="{Binding SelectedAccount}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Country" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Country, Converter={StaticResource CountryToFlag}}"
                                                   Width="28" Height="18" Stretch="Uniform"
                                                   HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="2*"/>
                                <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="*"/>
                                <DataGridTextColumn Header="Currency" Binding="{Binding CurrencyDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>