<Window x:Class="BankingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BankingSystem.ViewModel"
        xmlns:conv="clr-namespace:BankingSystem.Converters"
        Title="Banking System" Height="600" Width="1445"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:CountryToFlagConverter x:Key="CountryToFlag"/>

        <!-- Bazni flat stil -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Account = siva -->
        <Style x:Key="AccountButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#6B7280"/>
        </Style>

        <!-- Customer = plava -->
        <Style x:Key="CustomerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#2196F3"/>
        </Style>

        <!-- Destruktivno = crvena -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0"/>
            <GradientStop Color="#1D4ED8" Offset="0.5"/>
            <GradientStop Color="#38BDF8" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="16">
        <Border Background="#CCFFFFFF" CornerRadius="16" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <!-- ACCOUNT -->
                    <Button Content="Add Account"     Command="{Binding AddCommand}"           Width="120" Style="{StaticResource AccountButton}"/>
                    <Button Content="Account Details" Command="{Binding DetailsCommand}"       Width="130" Style="{StaticResource AccountButton}"/>
                    <Button Content="Update Account"  Command="{Binding UpdateAccountCommand}" Width="130" Style="{StaticResource AccountButton}"/>
                    <Button Content="Delete Account"  Command="{Binding DeleteCommand}"        Width="130" Style="{StaticResource AccountButton}"/>

                    <!-- Separator -->
                    <Border Width="1" Background="#9CA3AF" Margin="6,2,14,2"/>

                    <!-- CUSTOMER -->
                    <Button Content="Add Customer"      Command="{Binding AddCustomerCommand}"     Width="140" Style="{StaticResource CustomerButton}"/>
                    <Button Content="Customer Details"  Command="{Binding CustomerDetailsCommand}" Width="140" Style="{StaticResource CustomerButton}"/>
                    <Button Content="Update Customer"   Command="{Binding UpdateCustomerCommand}"  Width="150" Style="{StaticResource CustomerButton}"/>
                    <Button Content="Delete Customer"   Command="{Binding DeleteCustomerCommand}"  Width="145" Style="{StaticResource DangerButton}"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Customers" Margin="0,0,10,0">
                        <DataGrid ItemsSource="{Binding Customers}"
                                  SelectedItem="{Binding SelectedCustomer}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Accounts" Grid.Column="1">
                        <DataGrid ItemsSource="{Binding FilteredAccounts}"
                                  SelectedItem="{Binding SelectedAccount}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Country" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Country, Converter={StaticResource CountryToFlag}}"
                                                   Width="28" Height="18" Stretch="Uniform"
                                                   HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="2*"/>
                                <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="*"/>
                                <DataGridTextColumn Header="Currency" Binding="{Binding CurrencyDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>